[Container]
# prometheus-podman-exporter: métricas por container (cpu/mem/net/estado)
# leyendo el podman.sock del usuario. No usamos cAdvisor porque en
# rootless pelea con cgroup delegation; este solo llama a la API de
# podman, cero privilegios extra.
Image=quay.io/navidys/prometheus-podman-exporter:v1.14.0
ContainerName=podman-exporter
Pod=observability.pod

# Requiere: systemctl --user enable --now podman.socket (ver README)
Volume=%t/podman/podman.sock:/run/podman/podman.sock:ro
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock

Exec=--collector.enable-all

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
